{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "'/Users/anirudhtumuluru/Quant-desk/.codex/hooks/guard_write.py'",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "'/Users/anirudhtumuluru/Quant-desk/.codex/hooks/no_fabricated_numbers_pre.py'",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "'/Users/anirudhtumuluru/Quant-desk/.codex/hooks/guard_bash.py'",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "'/Users/anirudhtumuluru/Quant-desk/.codex/hooks/no_fabricated_numbers.py'",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
