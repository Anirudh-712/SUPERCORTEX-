# data lake — lives on disk / external SSD, never in git.
# ROOT-ANCHORED. An unanchored `data/` matches a directory of that name at ANY depth,
# which silently swallowed the whole of src/supercortex/data/ — four source files that
# were never committed and existed only on one machine.
/data/
/logs/
*.parquet

# python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/

# secrets — belt and braces; real secrets live in the Keychain
.env
.env.*
secrets/
*.pem
*.key

# local-only
CLAUDE.local.md
.claude/settings.local.json
.DS_Store

# literature PDFs (disk + copyright)
01-research/literature/pdf/

# cockpit runtime state — generated by `supercortex dash render`, disposable.
# The registry and hashed dataset bytes are authoritative; these are a mirror.
00-dashboard/.runtime/
00-dashboard/generated

# sqlite sidecars
*.sqlite-wal
*.sqlite-shm
.doctor-probe.sqlite*

# build output and personal editor state
.coverage
.obsidian/workspace.json
