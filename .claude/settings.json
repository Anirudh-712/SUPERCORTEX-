{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./.env*)",
      "Read(./secrets/**)",
      "Read(~/.aws/**)",
      "Read(~/.ssh/**)",
      "Edit(./06-risk/limits.yaml)",
      "Write(./06-risk/limits.yaml)",
      "Edit(./registry.sqlite)",
      "Write(./registry.sqlite)",
      "Bash(security find-generic-password:*)",
      "Bash(op read:*)",
      "Bash(rm -rf:*)"
    ],
    "ask": [
      "Bash(uv add:*)",
      "Bash(brew install:*)",
      "Bash(git push:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard_write.py",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard_bash.py",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/no_fabricated_numbers.py",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "sandbox": {
    "enabled": true,
    "filesystem": {
      "allowWrite": [
        ".",
        "~/.cache/uv"
      ]
    },
    "network": {
      "allowedDomains": [
        "data.binance.vision",
        "pypi.org",
        "files.pythonhosted.org",
        "github.com",
        "*.github.com",
        "*.githubusercontent.com",
        "arxiv.org",
        "export.arxiv.org",
        "api.openalex.org",
        "api.semanticscholar.org",
        "api.crossref.org",
        "api.anthropic.com",
        "statsig.anthropic.com",
        "sentry.io",
        "ntfy.sh"
      ]
    },
    "credentials": {
      "files": [
        {
          "path": "~/.aws",
          "mode": "deny"
        },
        {
          "path": "~/.ssh",
          "mode": "deny"
        },
        {
          "path": "~/.config/gcloud",
          "mode": "deny"
        },
        {
          "path": "~/.config/gh",
          "mode": "deny"
        }
      ],
      "envVars": [
        {
          "name": "BINANCE_API_SECRET",
          "mode": "deny"
        },
        {
          "name": "BYBIT_API_SECRET",
          "mode": "deny"
        },
        {
          "name": "OPENALGO_API_KEY",
          "mode": "deny"
        },
        {
          "name": "GH_TOKEN",
          "mode": "deny"
        },
        {
          "name": "GITHUB_TOKEN",
          "mode": "deny"
        }
      ]
    },
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false
  }
}
