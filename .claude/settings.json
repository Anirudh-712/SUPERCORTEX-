{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./.env*)",
      "Read(./secrets/**)",
      "Read(~/.aws/**)",
      "Read(~/.ssh/**)",
      "Edit(./06-risk/limits.yaml)",
      "Edit(./registry.sqlite)",
      "Bash(security find-generic-password:*)",
      "Bash(op read:*)",
      "Bash(rm -rf:*)",
      "WebFetch(domain:binance.com)",
      "WebFetch(domain:*.binance.com)",
      "WebFetch(domain:binance.us)",
      "WebFetch(domain:*.binance.us)",
      "WebFetch(domain:bybit.com)",
      "WebFetch(domain:*.bybit.com)",
      "WebFetch(domain:okx.com)",
      "WebFetch(domain:*.okx.com)",
      "WebFetch(domain:deribit.com)",
      "WebFetch(domain:*.deribit.com)",
      "WebFetch(domain:coinbase.com)",
      "WebFetch(domain:*.coinbase.com)",
      "WebFetch(domain:kraken.com)",
      "WebFetch(domain:*.kraken.com)",
      "WebFetch(domain:bitmex.com)",
      "WebFetch(domain:*.bitmex.com)",
      "WebFetch(domain:kucoin.com)",
      "WebFetch(domain:*.kucoin.com)",
      "WebFetch(domain:gate.io)",
      "WebFetch(domain:*.gate.io)",
      "WebFetch(domain:mexc.com)",
      "WebFetch(domain:*.mexc.com)",
      "WebFetch(domain:htx.com)",
      "WebFetch(domain:*.htx.com)",
      "WebFetch(domain:bitget.com)",
      "WebFetch(domain:*.bitget.com)",
      "WebFetch(domain:zerodha.com)",
      "WebFetch(domain:*.zerodha.com)",
      "WebFetch(domain:dhan.co)",
      "WebFetch(domain:*.dhan.co)",
      "WebFetch(domain:angelone.in)",
      "WebFetch(domain:*.angelone.in)",
      "WebFetch(domain:upstox.com)",
      "WebFetch(domain:*.upstox.com)",
      "WebFetch(domain:fyers.in)",
      "WebFetch(domain:*.fyers.in)",
      "WebFetch(domain:localhost)",
      "WebFetch(domain:127.0.0.1)"
    ],
    "ask": [
      "Bash(uv add:*)",
      "Bash(brew install:*)",
      "Bash(git push:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard_write.py",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/no_fabricated_numbers_pre.py",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard_bash.py",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/no_fabricated_numbers.py",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "sandbox": {
    "enabled": true,
    "filesystem": {
      "allowWrite": [
        ".",
        "~/.cache/uv"
      ]
    },
    "network": {
      "deniedDomains": [
        "binance.com",
        "*.binance.com",
        "binance.us",
        "*.binance.us",
        "bybit.com",
        "*.bybit.com",
        "okx.com",
        "*.okx.com",
        "deribit.com",
        "*.deribit.com",
        "coinbase.com",
        "*.coinbase.com",
        "kraken.com",
        "*.kraken.com",
        "bitmex.com",
        "*.bitmex.com",
        "kucoin.com",
        "*.kucoin.com",
        "gate.io",
        "*.gate.io",
        "mexc.com",
        "*.mexc.com",
        "htx.com",
        "*.htx.com",
        "bitget.com",
        "*.bitget.com",
        "zerodha.com",
        "*.zerodha.com",
        "dhan.co",
        "*.dhan.co",
        "angelone.in",
        "*.angelone.in",
        "upstox.com",
        "*.upstox.com",
        "fyers.in",
        "*.fyers.in"
      ],
      "allowedDomains": [
        "data.binance.vision",
        "pypi.org",
        "files.pythonhosted.org",
        "github.com",
        "*.github.com",
        "*.githubusercontent.com",
        "arxiv.org",
        "export.arxiv.org",
        "api.openalex.org",
        "api.semanticscholar.org",
        "api.crossref.org",
        "api.anthropic.com",
        "statsig.anthropic.com",
        "sentry.io",
        "ntfy.sh"
      ]
    },
    "credentials": {
      "files": [
        {
          "path": "~/.aws",
          "mode": "deny"
        },
        {
          "path": "~/.ssh",
          "mode": "deny"
        },
        {
          "path": "~/.config/gcloud",
          "mode": "deny"
        },
        {
          "path": "~/.config/gh",
          "mode": "deny"
        }
      ],
      "envVars": [
        {
          "name": "BINANCE_API_SECRET",
          "mode": "deny"
        },
        {
          "name": "BYBIT_API_SECRET",
          "mode": "deny"
        },
        {
          "name": "OPENALGO_API_KEY",
          "mode": "deny"
        },
        {
          "name": "GH_TOKEN",
          "mode": "deny"
        },
        {
          "name": "GITHUB_TOKEN",
          "mode": "deny"
        }
      ]
    },
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false
  }
}
