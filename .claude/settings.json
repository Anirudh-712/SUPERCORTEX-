{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./.env*)",
      "Read(./secrets/**)",
      "Read(~/.aws/**)",
      "Read(~/.ssh/**)",
      "Edit(./06-risk/limits.yaml)",
      "Write(./06-risk/limits.yaml)",
      "Edit(./registry.sqlite)",
      "Write(./registry.sqlite)",
      "Bash(security find-generic-password:*)",
      "Bash(op read:*)",
      "Bash(rm -rf:*)"
    ],
    "ask": [
      "Bash(uv add:*)",
      "Bash(brew install:*)",
      "Bash(git push:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [{ "type": "command", "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard_write.py", "timeout": 10 }]
      },
      {
        "matcher": "Bash",
        "hooks": [{ "type": "command", "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard_bash.py", "timeout": 10 }]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [{ "type": "command", "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/no_fabricated_numbers.py", "timeout": 15 }]
      }
    ]
  }
}
